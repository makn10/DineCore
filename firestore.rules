rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isUser(userId);
      allow delete: if false;
    }

    // Messes
    match /messes/{messId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid in resource.data.managerIds
      );

      // Members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Periods subcollection (months)
      match /periods/{periodId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Meals subcollection
      match /meals/{mealId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Bazar subcollection
      match /bazar/{bazarId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Deposits subcollection
      match /deposits/{depositId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Bills subcollection
      match /bills/{billId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Extra Costs subcollection
      match /extraCosts/{costId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Notices subcollection
      match /notices/{noticeId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Menu subcollection
      match /menu/{menuId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Routine subcollection
      match /routine/{routineId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      // Audit logs
      match /audit/{auditId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
